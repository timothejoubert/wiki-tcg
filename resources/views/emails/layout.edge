<!DOCTYPE html>
<html lang="fr">
  <body style="margin:0;padding:24px;background:#f5f5f6;font-family:-apple-system,Segoe UI,Roboto,Helvetica,Arial,sans-serif;color:#0a0a0b;">
    <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="max-width:520px;margin:0 auto;background:#ffffff;border-radius:12px;">
      <tr>
        <td style="padding:28px;">
          <p style="margin:0 0 20px;font-weight:700;font-size:18px;">{{ brandName }}</p>
          {{{ await $slots.main() }}}
          <p style="margin:28px 0 0;font-size:12px;color:#6b6f76;">
            Tu reçois cet email parce qu'une action a été demandée sur ton compte {{ brandName }}.
            Si ce n'est pas toi, ignore-le : rien ne changera.
          </p>
        </td>
      </tr>
    </table>
  </body>
</html>
