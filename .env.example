# Node
TZ=UTC
PORT=3333
HOST=localhost
NODE_ENV=development

# App
LOG_LEVEL=info
APP_KEY=
APP_URL=http://${HOST}:${PORT}

# Session
SESSION_DRIVER=cookie

# Database
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=wiki_tcg
DB_PASSWORD=wiki_tcg
DB_DATABASE=wiki_tcg

# Wikipedia — must identify the app and a contact (Wikimedia User-Agent policy)
WIKIPEDIA_USER_AGENT="WikiTCG/0.1 (contact@example.com)"
LIMITER_STORE=database
# Mail (Mailpit in development: http://localhost:8025)
MAIL_MAILER=smtp
MAIL_FROM_NAME="Wiki TCG"
MAIL_FROM_ADDRESS=noreply@wiki-tcg.test
SMTP_HOST=127.0.0.1
SMTP_PORT=1025